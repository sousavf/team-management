# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/holiday_planner"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server Configuration
PORT=3501
NODE_ENV=development

# Public URL of the frontend — used to build password-reset links in emails
FRONTEND_URL="http://localhost:3500"

# Team Capacity Configuration
PACE_FACTOR=0.8

# Email / SMTP Configuration
# Required for time-off notifications and password-reset emails.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_NAME="Holiday Planner"
SMTP_FROM_EMAIL="noreply@example.com"

# JIRA Integration Configuration
JIRA_URL="https://your-company.atlassian.net"
JIRA_EMAIL="your-email@company.com"
JIRA_API_TOKEN="your-jira-api-token"
JIRA_POLL_INTERVAL_SECONDS=300
